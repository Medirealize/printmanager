# Supabase（未設定・プレースホルダーのままならモックデータで動作）
# ★ 初回は SQL Editor で supabase/schema.sql を必ず実行してください
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# デモ世帯ID（supabase/schema.sql の seed と一致）
DEFAULT_HOUSEHOLD_ID=00000000-0000-0000-0000-000000000001

# Gemini（未設定時はモックAIで動作）
GEMINI_API_KEY=your-gemini-api-key
# 任意: 使用モデル（未設定時は複数モデルを順に試行）
# GEMINI_MODEL=gemini-2.5-flash-lite
